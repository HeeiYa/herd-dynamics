[node name="Decision" type="Label" parent="Content"]
layout_mode = 2
mouse_filter = 1
theme_override_font_sizes/font_size = 12
tooltip_text = "仅所选角色距最近一次决策的模拟时间，不是全群响应分位数或墙钟响应。暂停时不增长；等待首次/恢复感知单独标记。"
