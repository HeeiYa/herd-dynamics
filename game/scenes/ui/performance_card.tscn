[node name="Status" type="Label" parent="Content"]
layout_mode = 2
mouse_filter = 1
theme_override_font_sizes/font_size = 12
tooltip_text = "模拟低于目标的98%、显示年龄超过100ms、帧P95超过16.67ms、可靠交付等待超过1%或缺失意图超过0.1%时分别提示。阈值用于观察，不代表行为验收。"
text = "正在采样"

[node name="Stats" type="Label" parent="Content"]
visible = false
