[node name="Population" type="Label" parent="Content"]
layout_mode = 2
mouse_filter = 1
theme_override_font_sizes/font_size = 12
tooltip_text = "最新可靠发布中，存活且未被提起的角色有多少缺少有效运动意图；不是完整AI响应验收。inline不新增全群扫描。"
