[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/presentation/tuning_panel.gd" id="script"]

[node name="Tuning" type="VBoxContainer"]
script = ExtResource("script")
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="Introduction" type="Label" parent="."]
modulate = Color(0.47843137, 0.41568628, 0.33333334, 1)
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "生态参数松开后提交，下一模拟步应用。场地参数保存为草稿，点击重新生成后应用；生成会丢弃未应用的生态修改。"
autowrap_mode = 3

[node name="Rows" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="Footer" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Restore" type="Button" parent="Footer"]
layout_mode = 2
focus_mode = 0
text = "全部恢复默认"

[node name="ApplyGeneration" type="Button" parent="Footer"]
layout_mode = 2
focus_mode = 0
text = "应用场地并生成"

[node name="Status" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "本次运行已修改 0 次"
autowrap_mode = 3
